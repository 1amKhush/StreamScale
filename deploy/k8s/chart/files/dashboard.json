{
  "uid": "streamscale",
  "title": "StreamScale \u2014 pipeline and Kafka backlog",
  "tags": [
    "streamscale"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "Accepted facts (this process)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "streamscale-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(streamscale_accepted_total{run_id=\"$run\"})",
          "legendFormat": "{{__name__}} {{partition}} {{stage}} {{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "Generated / acknowledged attempts",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "streamscale-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "streamscale_generated_total{run_id=\"$run\"}",
          "legendFormat": "{{__name__}} {{partition}} {{stage}} {{pod}}"
        },
        {
          "refId": "B",
          "expr": "streamscale_published_total{run_id=\"$run\"}",
          "legendFormat": "acknowledged"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Kafka backlog",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "streamscale-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(streamscale_kafka_lag{run_id=\"$run\"})",
          "legendFormat": "{{__name__}} {{partition}} {{stage}} {{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Live consumer group members",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "streamscale-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "streamscale_consumer_replicas{run_id=\"$run\"}",
          "legendFormat": "{{__name__}} {{partition}} {{stage}} {{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "Current accepted throughput",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "streamscale-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(streamscale_accepted_total{run_id=\"$run\"}[2m]))",
          "legendFormat": "{{__name__}} {{partition}} {{stage}} {{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Unique commit latency p95 (this process)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "streamscale-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (streamscale_end_to_end_seconds_bucket{run_id=\"$run\"}))",
          "legendFormat": "{{__name__}} {{partition}} {{stage}} {{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "DB handling p95 (includes retries)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "streamscale-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (streamscale_db_seconds_bucket{run_id=\"$run\",result=\"accepted\"}))",
          "legendFormat": "{{__name__}} {{partition}} {{stage}} {{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Kafka lag by partition",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "streamscale-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "streamscale_kafka_lag{run_id=\"$run\"}",
          "legendFormat": "{{__name__}} {{partition}} {{stage}} {{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Duplicate / invalid / DLQ attempts",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "streamscale-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"streamscale_(duplicate|invalid|dlq)_total\",run_id=\"$run\"}",
          "legendFormat": "{{__name__}} {{partition}} {{stage}} {{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Failed handling attempts",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "streamscale-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "streamscale_failed_total{run_id=\"$run\"}",
          "legendFormat": "{{__name__}} {{partition}} {{stage}} {{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Consumer resident memory",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "streamscale-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"consumer\"}",
          "legendFormat": "{{__name__}} {{partition}} {{stage}} {{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "title": "Consumer CPU cores",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "streamscale-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=\"consumer\"}[2m])",
          "legendFormat": "{{__name__}} {{partition}} {{stage}} {{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    }
  ],
  "templating": {
    "list": [
      {
        "name": "run",
        "label": "Run ID",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "streamscale-prometheus"
        },
        "query": "label_values(streamscale_generated_total, run_id)",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "sort": 1
      }
    ]
  }
}
