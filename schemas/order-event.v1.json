{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:streamscale:order-event:v1",
  "title": "StreamScale order event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "event_id", "order_id", "event_type", "event_time", "produced_at", "order_amount", "schema_version"],
  "properties": {
    "run_id": {"$ref": "#/$defs/uuid"},
    "event_id": {"$ref": "#/$defs/uuid"},
    "order_id": {"$ref": "#/$defs/uuid"},
    "event_type": {"enum": ["ORDER_CREATED", "PAYMENT_CONFIRMED", "ORDER_CANCELLED"]},
    "event_time": {"$ref": "#/$defs/timestamp"},
    "produced_at": {"$ref": "#/$defs/timestamp"},
    "order_amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,15})\\.[0-9]{2}(?![\\s\\S])",
      "description": "Exact nonnegative decimal, at most 16 whole digits and exactly two fractional digits; maps to NUMERIC(18,2)."
    },
    "schema_version": {"type": "integer", "const": 1}
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])",
      "description": "Timezone-aware RFC 3339 subset, full seconds and optional 1-6 fractional digits; no leap seconds or unknown offset -00:00."
    }
  }
}
