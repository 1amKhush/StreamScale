{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:streamscale:dlq-envelope:v1",
  "title": "StreamScale DLQ envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "original_key_base64", "original_payload_base64", "source", "error_code", "detail", "failed_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "original_key_base64": {"$ref": "#/$defs/bytes"},
    "original_payload_base64": {"$ref": "#/$defs/bytes"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "partition", "offset"],
      "properties": {
        "topic": {"const": "orders.events.v1"},
        "partition": {"type": "integer", "minimum": 0, "maximum": 2},
        "offset": {"type": "integer", "minimum": 0}
      }
    },
    "error_code": {
      "enum": ["INVALID_ENCODING", "INVALID_JSON", "SCHEMA_VALIDATION_FAILED", "UNSUPPORTED_SCHEMA_VERSION", "UNSUPPORTED_EVENT_TYPE", "INVALID_AMOUNT", "INVALID_TIMESTAMP", "KEY_MISMATCH"]
    },
    "detail": {"type": "string", "minLength": 1, "maxLength": 256},
    "failed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])"
    }
  },
  "$defs": {
    "bytes": {
      "type": ["string", "null"],
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])",
      "description": "Original bytes, losslessly encoded. Null is absent bytes; empty string is present empty bytes."
    }
  }
}
